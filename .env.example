# Public event landing page; replace with the actual '剧综人物' leaderboard URL if distinct.
VOTING_URL=https://t.cn/AXWvhBOy
STAGE=final
STORAGE_BACKEND=sqlite
SQLITE_PATH=score_snapshots.db

# Optional: MuMu ADB path/serial. Common MuMu locations are auto-detected.
# ADB_PATH=D:\Program Files\Netease\MuMu\nx_main\adb.exe
# Usually leave ADB_SERIAL unset so the current MuMu port is auto-detected.
# ADB_SERIAL=127.0.0.1:16384
# MUMU_CLI_PATH=D:\Program Files\Netease\MuMu\nx_main\mumu-cli.exe
# Reload the activity in Weibo before each live capture (recommended).
MUMU_REFRESH_STRATEGY=deeplink
MUMU_REFRESH_WAIT_SECONDS=8
# Deep-link refresh can preserve the WebView scroll offset. Verify rank 1 is
# visible and scroll back toward the top before every live capture.
MUMU_TOP_RESET_MAX_SWIPES=12
# WEIBO_ACTIVITY_URL=https://m.weibo.cn/c/wbox?id=l331zrkexk&cid=1420
# Local-only avatar fallback used if candidate names disappear from the UI tree.
AVATAR_REFERENCE_DIR=avatar_references
AVATAR_TARGET_CANDIDATES=15
AVATAR_MATCH_THRESHOLD=0.88
AVATAR_MATCH_MARGIN=0.05
# Historical UI XML that still contains candidate names; enrollment suggestions
# must always be checked manually against avatar_references/contact_sheet.png.
AVATAR_HISTORICAL_XML=debug/window_20261022_222605.xml

# Determined only after inspecting permitted public page markup.
# These example selectors are deliberately blank: do not pretend they are verified.
CATEGORY_TAB_SELECTOR=
CARD_SELECTOR=
NAME_SELECTOR=
SCORE_SELECTOR=
RANK_SELECTOR=
ID_ATTRIBUTE=
SCROLL_ROUNDS=3

# For local collector writes, set STORAGE_BACKEND=supabase and configure:
SUPABASE_URL=
# Preferred current key names:
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Legacy key names are also accepted:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
